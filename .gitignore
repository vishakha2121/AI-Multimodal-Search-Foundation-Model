# ============================================
# ALLOW SPECIFIC FILES
# ============================================

# Allow these files even if they are in ignored directories
!uploads/.gitkeep
!media/.gitkeep
!logs/.gitkeep
!tmp/.gitkeep
!temp/.gitkeep
!dist/.gitkeep

# Allow environment examples
!.env.example
!.env.sample

# Allow specific key files
!*.example.*
!*.sample.*

# Allow build artifacts if needed
!*.d.ts
!*.d.ts.map

